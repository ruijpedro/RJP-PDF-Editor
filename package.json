{
  "name": "rjp-pdf-editor-universal",
  "private": true,
  "version": "4.6.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "desktop": "npm run build && electron .",
    "windows:dist": "npm run build && electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "5.4.149",
    "@capacitor/core": "^7.0.0",
    "@capacitor/android": "^7.0.0"
  },
  "devDependencies": {
    "vite": "7.1.3",
    "@capacitor/cli": "^7.0.0",
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "pt.rjp.pdfeditor.windows",
    "productName": "RJP PDF Editor",
    "asar": true,
    "directories": {
      "output": "release/windows"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "artifactName": "RJP-PDF-Editor-Setup-${version}.${ext}",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "RJP PDF Editor",
      "deleteAppDataOnUninstall": false
    }
  },
  "description": "RJP PDF Editor V4.6.2 universal para Web, Android e Windows, com scroll contínuo multipágina, edição não destrutiva e inserção de imagens.",
  "author": "RJP"
}
